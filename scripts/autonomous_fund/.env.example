# Copy to an ignored .env; on Linux chmod 600. Never commit real values.
# Required for the configured Flash researcher and V4 Pro decision maker:
DEEPSEEK_API_KEY=
# Required for Telegram approvals, anomalies and daily report attachments:
FUND_TELEGRAM_BOT_TOKEN=
FUND_TELEGRAM_CHAT_ID=
# Telegram replies 同意/拒绝 approve plan requests (on by default). Private chat: its owner approves.
# Group chats need explicit approver user IDs (comma-separated). Set FUND_TELEGRAM_APPROVALS=off to disable.
# FUND_TELEGRAM_APPROVER_IDS=
# FUND_TELEGRAM_APPROVALS=on
# SEC EDGAR filings in the news watch require a declared contact, e.g. "Your Name you@example.com":
# FUND_SEC_USER_AGENT=

# Only for --mode paper (Alpaca PAPER keys; cash above mandate.capital_usd is reserved):
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_IS_PAPER=true

# Optional providers: also select an exact model using CLI role arguments.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FRED_API_KEY=
# Optional BotSpot/cloud reporting; not required for local trading:
# LUMIWEALTH_API_KEY=

# Do not set AI_MODEL unless intentionally overriding BOTH role defaults.
# No live-money mode is available. Secret files cannot enable one.
