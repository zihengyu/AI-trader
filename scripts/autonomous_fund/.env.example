# =====================================================================
# AI 自主模拟基金：运营者配置（.env）
# 复制到仓库根目录的 .env（已被 Git 忽略）；Linux 上 chmod 600。绝不提交真实值。
# 优先级：进程环境变量 > 本文件 > scripts/autonomous_fund/config.json。
# 留空的行表示“不设置”，沿用 config.json 的默认值；本文件中写错的 FUND_* 名称会直接报错。
# 查看最终生效的配置及来源：python -m scripts.autonomous_fund.run show-config --env-file .env
# 本应用没有实盘入口；任何配置都不能开启真钱交易。
# =====================================================================

# ---------- 0. 启动模式 ----------
# 不带命令启动（scripts/run_autonomous_fund.sh 或 .ps1）以及服务器服务重启时，按这里的模式运行：
#   local = 真实行情本地模拟盘：Yahoo 实时行情 + 本地虚拟资金，可选下方 Alpaca 行情凭证；
#   paper = Alpaca 模拟账户：券商的模拟撮合，需要下方 ALPACA_* 的 Paper Key。
# 没有实盘选项：写 live、schwab 或任何其他值都会拒绝启动。修改后重新启动生效；
# 服务器上两个服务要一起重启，重启后保持 STOP，核对后用 resume 恢复交易。
FUND_MODE=local
# 账户运行目录（账本、报告、STOP 标记）。留空为 artifacts/fund-<模式>，local 和 paper 自动分开；
# stop、approvals、report 等命令不带 --run-dir 时也作用于这里。服务器服务要求放在仓库的 artifacts/ 下。
FUND_RUN_DIR=
# 只读观察（仅 local）：不调用模型、不下单，没有模型 Key 时可先检查启动、行情和资金记录。
FUND_OBSERVE_ONLY=false
# 自动恢复：服务重启、进程退出或卡死造成的 STOP，在监控确认连续健康 3 分钟、没有状态不明的订单后自动解除，
# 每 24 小时最多 3 次（超过则通知你人工处理）。你用 stop 命令设置的 STOP 永远不会自动解除。
FUND_AUTO_RESUME=true

# ---------- 1. 模型 Key 与模型选择 ----------
# 必填：默认研究员（Flash）和基金经理（V4 Pro）都使用 DeepSeek。
DEEPSEEK_API_KEY=
# 选用其他提供方的模型时才需要：
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# 角色模型（格式 提供方/模型ID）；不填则用 config.json 的 agent_models。
# FUND_RESEARCH_MODEL=deepseek/deepseek-flash
# FUND_DECISION_MODEL=deepseek/deepseek-v4-pro
# 基金经理每次尝试的整轮超时，单位秒。默认 300，盘中决策和盘后复盘都使用此值。
# FUND_MANAGER_RUN_TIMEOUT_SECONDS=360
# 反方审查：研究员之后、基金经理之前，由另一个 AI 角色专门找研究的漏洞和反面证据，基金经理需要回应。
# 每次决策多一次模型调用（默认用研究员的便宜模型）。
FUND_CRITIC=true
# FUND_CRITIC_MODEL=
# 盘中事件判断：普通新闻和价格异动先由快速模型（默认研究员模型）判断要不要叫基金经理，市场压力、价格提醒、
# 止损止盈后仍直接叫基金经理。auto（默认）直接生效：每 5 次"不需要"仍抽查一次基金经理，漏判变多自动退回影子运行，
# 达标后再自动生效（想先影子验证，在 config.json 把 triage.start 设为 shadow）。shadow 只打分，enforce 一直生效，off 关闭。
# FUND_TRIAGE=auto
# FUND_TRIAGE_MODEL=
# 同时覆盖两个角色（通常不需要）：
# AI_MODEL=
# 推理强度 low/medium/high：
# FUND_REASONING_EFFORT=
# 费用控制：每个交易日最多 Agent 调用次数、两次复核的最短间隔（分钟）。
FUND_MAX_AGENT_RUNS_PER_DAY=60
FUND_MIN_REVIEW_MINUTES=15
# 到点复核时若什么都没变（无提醒/大幅波动/新闻命中、无成交、持仓和研究不变）就不调用模型；
# 但每个交易时段至少每 FUND_MAX_QUIET_MINUTES 分钟调用一次基金经理。
FUND_SKIP_QUIET_REVIEWS=true
FUND_MAX_QUIET_MINUTES=120
# 每百万 token 的美元价格（JSON，按你账户在模型官网的实际价格填写）：input 普通输入、output 输出、
# cached_input 缓存命中的输入（通常便宜得多；不填则按 input 计，偏保守）。填了以后，日报和 fund-logs.sh 会显示
# 每天的模型费用，以及“AI 每年至少要跑赢基准多少才能打平费用”。
# FUND_MODEL_PRICES_JSON={"deepseek/deepseek-flash":{"input":0,"output":0,"cached_input":0},"deepseek/deepseek-v4-pro":{"input":0,"output":0,"cached_input":0}}
# 每个交易日的模型费用上限（美元，需要先填上面的价格）；到达后当天不再发起新决策、反方审查和盘前研究，
# 已有目标和止损照常执行，盘后复盘照常运行。不填表示不限：
# FUND_MAX_DAILY_COST_USD=
# AI 和数据费用累计每达到起始资金的这个比例就提醒一次（默认 0.02 = 2%）；只提醒，不停止交易
# FUND_COST_ALERT_SHARE=0.02

# ---------- 2. 用户约束（由代码强制执行） ----------
# AI 可用的授权资金（美元）。账户有 50000 而只给 AI 用 10000，就写 10000；
# 写 account 表示整个专用账户都交给 AI。超出部分是保留现金，AI 永远不能动用，也不可能加杠杆。
FUND_CAPITAL_USD=10000
# 账户里是否有你自己的持仓（投资范围以外的股票）；true 时 AI 不碰它们，数量变化会暂停交易等你确认。
FUND_ALLOW_EXTERNAL_HOLDINGS=false
# 本地虚拟账户的初始资金（只在第一次创建本地账本时生效）。
FUND_LOCAL_ACCOUNT_USD=10000
# 单只证券最大权重、证券总敞口上限、回撤硬锁（达到后停止加仓，需人工 reset-drawdown）。
FUND_MAX_POSITION=0.10
FUND_MAX_EXPOSURE=0.70
FUND_MAX_DRAWDOWN=0.08
# 当日亏损达到该比例后当天不再买入（次日自动恢复）。
FUND_DAILY_LOSS_LIMIT=0.02
# 组合年化波动率目标、1 日 97.5% 尾部损失上限（超过时自动等比例降仓）。
FUND_TARGET_VOL=0.12
FUND_MAX_ES=0.02
# 历史危机情景压力测试：把目标组合放进 2008 金融危机、2020 新冠暴跌、2022 加息熊市，按买入持有算整段亏损，
# 超过该比例时自动等比例降仓。
FUND_MAX_SCENARIO_LOSS=0.35
# 组合暴露上限：相对 SPY 的 beta（各持仓权重×beta 之和），以及动量、波动、规模三种风格的倾斜
# （权重×交易范围内标准分之和的绝对值）。超过时只按比例缩减推高这项暴露的证券。
FUND_MAX_PORTFOLIO_BETA=1.0
FUND_MAX_STYLE_EXPOSURE=0.75
# 闲置现金自动买入短期国债 ETF（SGOV）赚取国债收益；AI 买入证券前先卖出 SGOV 筹款。
# SGOV 在风控、审批和每日额度里一律视为现金，AI 不能把它作为投资目标。
FUND_CASH_SWEEP=true
# 财报事件风险：个股在财报日当天或下一个交易日之前，权重自动降到该上限以内（超出部分自动卖出），过了财报日恢复。
# 止损挡不住隔夜跳空，财报是最常见的原因。ETF 不受影响；日历拿不到时不猜测，只在风险信息里标注。
FUND_EARNINGS_GUARD=true
FUND_EARNINGS_MAX_POSITION=0.05
# 组合构建：ai = 按 AI 给的权重；risk_budget = 同样的证券和总仓位，按 AI 权重分配风险贡献（波动低的分到更多权重）；
# auto = 先用 ai，每天把两种构建方式都打分，至少 20 个交易日且 |t| ≥ 2 时自动切换并通知你。
FUND_CONSTRUCTION_MODE=auto
# 每日提交上限（含改价重挂）。买入计入当日全部提交；卖出另计一份同样大小的额度，
# 保护性止损／止盈再多 5 次，买入用尽额度也不会挡住降风险卖出。
FUND_DAILY_ORDERS=20
# 投资范围：默认 93 个，研究员、基金经理和数据员都覆盖它们：56 只大盘股；28 只非杠杆 ETF（大盘指数、11 个行业、
# 国债和通胀保值债、黄金、动量／质量／低波／价值因子，以及市场中性 BTAL、管理期货 DBMF、尾部对冲 TAIL、美元 UUP）；
# 8 只对冲工具（反向 SH、PSQ、DOG、RWM，两倍反向 SDS、QID，反向长债 TBF，波动率 VIXY）；短债 SGOV。
# 你只需要在下面加入自己希望研究和交易的股票。
# 加入股票或 ETF，逗号分隔；写成 代码:分组 会计入该行业的仓位上限（分组：technology、communication、
# consumer_discretionary、financials、health_care、energy、consumer_staples、industrials、materials、utilities、
# real_estate、us_growth_megacap、us_broad_index、treasury_duration）。不写分组只受单只上限约束。
# 范围越大，每次 AI 调用的输入越长、数据员拉取越慢。
# FUND_EXTRA_STOCKS=SHOP:technology,UBER:industrials
# FUND_EXTRA_ETFS=SMH:technology,VNQ:real_estate
# 再加入其他杠杆、反向或波动率 ETF（如 SQQQ、UVXY）：只能写在这里，不能混进上面两项。
# 它们每天重置倍数，持有越久偏离越大，波动率产品还有展期损耗；AI 被要求说明用途和退出条件。
# FUND_EXTRA_LEVERAGED_ETFS=SQQQ,UVXY
# 这类产品合计最大权重和单只最大权重（另外仍受单只上限、波动率目标、尾部损失等全部风控约束）。
FUND_MAX_LEVERAGED_TOTAL=
FUND_MAX_LEVERAGED_POSITION=
# 只供因子研究、不交易的额外股票（扩大横截面），逗号分隔：
# FUND_RESEARCH_SYMBOLS=SNOW,CRWD
# 调整分组的合计仓位上限（只有你能改，AI 只在上限内决定实际配多少；只能改上面列出的已有分组，0 到 1 之间）。
# 默认：technology 0.30、financials 0.30、health_care 0.25、consumer_staples 0.25、industrials 0.25、communication 0.20、
# consumer_discretionary 0.20、energy 0.15、materials 0.15、utilities 0.15、real_estate 0.15、us_growth_megacap 0.35、
# us_broad_index 0.40、treasury_duration 0.30、us_factor 0.30、alternatives 0.20。只计算直接持有的股票和 ETF，不拆开指数 ETF。
# FUND_GROUP_LIMITS=technology:0.40,energy:0.10
# 禁止交易的代码，逗号分隔，例如 NVDA,TSLA（从投资范围和分组中移除，也可以移除上面加入的代码）。
FUND_EXCLUDE_SYMBOLS=
# 给 AI 的文字约束，多条用 | 分隔。AI 每次决策都会收到，复盘时须逐条自评是否遵守。
# 只禁止借钱买入（融资）和借股票卖出（融券卖空），代码也会拦截；卖出、减仓、清仓自己持有的证券随时可以，且不需要审批。
FUND_INSTRUCTIONS="只用授权资金交易，账户中其余现金和持仓不属于你，不得动用。|不借钱买入（融资）、不借股票卖出（融券卖空）、不用期权或期货；杠杆、反向和波动率 ETF 只能用投资范围中列出的，并受其仓位上限约束；卖出、减仓、清仓自己持有的证券不受限制。"

# ---------- 3. 审批额度 ----------
# 当日总敞口增幅不超过该比例的买入自动执行；设为 0 表示所有买入都要你审批。卖出永远不需要审批。
FUND_AUTO_DAILY_EXPOSURE_INCREASE=0.25
# 当日买入现金流不超过净值该比例时自动执行。
FUND_AUTO_DAILY_BUY_TURNOVER=0.40
# 市场压力（SPY 大跌或高波动）时买入是否需要审批。
FUND_STRESS_REQUIRES_APPROVAL=true
# 审批请求有效分钟数。
FUND_APPROVAL_VALID_MINUTES=60

# ---------- 4. Telegram 通知与手机审批 ----------
# 必填（服务器部署）：机器人 Token 和接收会话 ID。在 Telegram 里直接回复审批提醒「同意」或「拒绝」即可。
FUND_TELEGRAM_BOT_TOKEN=
FUND_TELEGRAM_CHAT_ID=
# 群组中可审批的用户 ID（逗号分隔）；私聊不需要。设 off 则 Telegram 只通知、不接受回复审批。
# FUND_TELEGRAM_APPROVER_IDS=
FUND_TELEGRAM_APPROVALS=on

# ---------- 5. 外部数据与运行参数 ----------
# 盯盘迭代间隔（秒，15–300）；越短止损和提醒反应越快。
FUND_ITERATION_SECONDS=30
# 是否使用 Yahoo 实时推送报价（非官方接口；拿不到时自动回退到分钟线）。
FUND_LIVE_STREAM=true
# 研究网页的域名解析：system 或 doh（OpenClash 等 Fake-IP 代理下用 doh）。
FUND_RESEARCH_RESOLVER=system
# 数据员（常驻服务 lumibot-fund-desk）：持续拉取整理资讯、盘中行情、FRED、财报日历和 SEC 财报，
# 提前算好行情快照，研究员和基金经理随时读到最新数据；它停了交易进程会自己拉，交易不受影响。
FUND_DATA_DESK=true
# 盘中行情刷新间隔（秒）：
FUND_DESK_INTRADAY_SECONDS=300
# 实时资讯监控：开关、轮询间隔（秒）、长期关注的搜索词（| 分隔）、自定义 RSS（名称=https://... | 分隔）。
FUND_NEWS_ENABLED=true
FUND_NEWS_POLL_SECONDS=300
FUND_NEWS_QUERIES="Federal Reserve interest rate decision|US CPI inflation report|US jobs report nonfarm payrolls"
# FUND_NEWS_RSS_FEEDS=
# SEC EDGAR 要求声明联系人（姓名＋邮箱）才能读取持仓公司的 8-K 公告，以及因子实验室使用的
# 按披露日的财报基本面（盈利、营收、毛利、经营现金流、净资产、总资产、股本），例如 "Your Name you@example.com"：
# FUND_SEC_USER_AGENT=
# FRED 宏观环境：美债 3 月／2 年／10 年收益率、10y-2y 利差、高收益债利差、VIX，作为 AI 的参考信息。
FUND_MACRO=true
# FRED Key（推荐，免费申请 https://fred.stlouisfed.org）：数据员用它拉经济日历（CPI、非农、GDP、FOMC 等公布日期）；
# 不填时宏观数据用公开 CSV 下载，经济日历不可用。
# FRED_API_KEY=
# Finnhub Key（可选）：更可靠的财报日历，不填用 Yahoo：
# FINNHUB_API_KEY=
# 影子 A/B：每天多一次对照决策，验证 AI 的复盘学习是否真的有效。
FUND_SHADOW_AB=true
# 因子实验室：AI 在盘后复盘中提出因子表达式，代码用无前视历史数据检验（样本内＋样本外＋多重检验校正），
# 通过的因子及其实盘表现在之后的决策中提供给 AI；因子只作证据，不直接下单。
FUND_FACTOR_LAB=true
# 各模型训练数据的截止日（向模型提供方查询后填写，不确定就不填）。因子历史检验中截止日之后的样本单独记为“干净样本外”；
# 不填时所有历史检验都标为“可能受模型记忆影响”。例：{"deepseek-chat": "YYYY-MM-DD"}
# FUND_MODEL_KNOWLEDGE_CUTOFF_JSON=
# 付费数据订阅的月费（美元，默认 0）。系统净收益在账户净收益之外再扣模型费用和这一项；业绩基准见 config.json 的 performance 段。
# FUND_DATA_COSTS_USD_PER_MONTH=0

# ---------- 6. Alpaca 行情与模拟账户 ----------
# local：可选。两个凭证都填后才启用日线核对及备用行情。ALPACA_IS_PAPER 在此模式下不读取。
# paper：必填 Paper 账户凭证；首次启动时现金不少于 FUND_CAPITAL_USD，超出部分记为保留现金。
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# 仅 paper 模式读取，默认 true；false 会拒绝启动。
# ALPACA_IS_PAPER=true
# 可选：BotSpot／云端报告，本地交易不需要。
# LUMIWEALTH_API_KEY=

# ---------- 7. Schwab（实盘前的只读体检：schwab-check） ----------
# 本应用目前没有实盘入口；以下配置只用于只读读取账户、持仓和挂单，代码层面禁止下单／撤单／改单。
# 强烈建议在 Schwab 单独开一个给 AI 的账户（同一登录下可有多个账户），避免与你自己的持仓混在一起。
# 若与你的持仓共用一个账户：设 FUND_ALLOW_EXTERNAL_HOLDINGS=true；你已持有的代码会自动从 AI 可交易范围中剔除。
# SCHWAB_ACCOUNT_NUMBER=
# 你自己的 Schwab 开发者应用（不填则使用 LumiBot 默认应用，OAuth 回调经过 api.botspot.trade）：
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_BACKEND_CALLBACK_URL=https://127.0.0.1:8182
# 无浏览器的服务器首次登录：把授权页面给出的一次性字符串填到这里；token 文件放在私有目录：
# SCHWAB_TOKEN=
# SCHWAB_TOKEN_PATH=
